# Dependencies
node_modules/

# Build output (dist/viewer is committed intentionally — see README)
packages/viewer/dist/
# tf-import-blocks emits JavaScript + declarations that both consumers now load
# instead of its TypeScript source. It is generated, never edited, and rebuilt
# by the package's `prepare` script on every `npm install` — committing it would
# add a copy that nothing in this repo ever verifies is current.
packages/tf-import-blocks/dist/
*.tsbuildinfo

# OS / editor / session-local tooling
.DS_Store
*.local
.claude/

# Logs
npm-debug.log*
*.log

# Raw Terraform state must never land in the repo (it can contain secrets) —
# import it with `npm run tf-import`, which extracts identifiers only.
*.tfstate
*.tfstate.backup
